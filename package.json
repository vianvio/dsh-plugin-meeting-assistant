{
  "name": "dsh-plugin-meeting-assistant",
  "version": "0.1.8",
  "type": "module",
  "license": "MIT",
  "description": "DSH 会议助手：本机麦克风采集与 DashScope 流式转写、会前准备、会中发言建议与会后记录。独立插件，不依赖 Agent Mesh 或任何平台连接。",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "assets/readme",
    "!lib/*.map"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "pretest": "node build.mjs",
    "test": "node --import tsx --test test/*.test.ts && node --test test/voice-kernel/*.test.mjs",
    "test:voice-kernel": "node --test test/voice-kernel/*.test.mjs",
    "test:ui": "node scripts/meeting-ui-check.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepare": "node build.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "meeting",
    "asr",
    "transcription",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "fflate": "0.8.3",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session": "0.2.1-rc.4",
    "@deepseek-ai/dsh-session-format-catalog": "^0.2.1-rc.4",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.4",
    "@types/node": "^24.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "18.3.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0-0",
    "react-dom": ">=18 <20",
    "@deepseek-ai/dsh-plugin-manager": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-plugin-manager": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vianvio/dsh-plugin-meeting-assistant.git"
  },
  "homepage": "https://github.com/vianvio/dsh-plugin-meeting-assistant#readme",
  "bugs": {
    "url": "https://github.com/vianvio/dsh-plugin-meeting-assistant/issues"
  },
  "author": "vianvio",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
